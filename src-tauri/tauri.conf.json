{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "nodeblocks-editor",
  "version": "0.1.3",
  "identifier": "com.github.ydewolf.nodeblocks",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/fetch-uv.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-uv.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "nodeblocks",
        "width": 1024,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/uv"
    ]
  }
}
